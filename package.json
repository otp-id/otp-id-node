{
  "name": "@otp-id/sdk",
  "version": "0.1.0",
  "description": "Official OTP.ID SDK for Node.js/TypeScript — multi-channel OTP delivery (WhatsApp, SMS, Email, Missed Call, Voice) with prepaid billing.",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "prepack": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "otp",
    "whatsapp",
    "sms",
    "voice",
    "email",
    "2fa",
    "indonesia",
    "sdk",
    "otp.id"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/otp-id/otp-id-node.git"
  },
  "homepage": "https://github.com/otp-id/otp-id-node",
  "bugs": {
    "url": "https://github.com/otp-id/otp-id-node/issues"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3",
    "tsup": "^8.5.1",
    "vitest": "^4.1.10"
  }
}
